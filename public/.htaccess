Options -Indexes
RewriteEngine On

<FilesMatch "^(?!index\.php$).+\.php$">
    Require all denied
</FilesMatch>

# Static files are served directly; everything else goes to the front controller.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]

# ---- Performance -----------------------------------------------------------
# Every IfModule block is optional: hosts without a module simply skip it.

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
    # CSS/JS URLs carry ?v=<mtime> (see asset()), so they can be cached forever safely.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(svg|png|jpe?g|webp|gif|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(css|js|svg|png|jpe?g|webp|gif|ico|woff2?)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

# PWA: the service worker and manifest must always be re-checked so updates reach every device.
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest|offline\.html)$">
        Header set Cache-Control "no-cache"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
</IfModule>
