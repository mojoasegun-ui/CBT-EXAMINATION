{
    "name": "ExamCore CBT",
    "short_name": "ExamCore",
    "description": "Computer-based exams, practice and results for Nigerian schools.",
    "lang": "en-NG",
    "dir": "ltr",
    "start_url": "./?source=pwa",
    "scope": "./",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone"],
    "orientation": "any",
