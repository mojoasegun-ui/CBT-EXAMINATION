{
    "name": "examcore/cbt",
    "description": "A modular computer-based testing platform foundation.",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "chillerlan/php-qrcode": "^5.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ExamCore\\": "app/"
        },
        "files": ["app/Helpers/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "ExamCore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
