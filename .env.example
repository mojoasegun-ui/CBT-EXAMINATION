APP_NAME="ExamCore CBT"
APP_VERSION="1.0.0"
# production hides error details; use "local" with APP_DEBUG=true only on your own machine.
APP_ENV=production
APP_DEBUG=false
# Full public URL including any subfolder, e.g. https://cbt.yourschool.ng or http://localhost/CBT-EXAMINATION
APP_BASE_URL=
APP_TIMEZONE=Africa/Lagos
PASS_MARK_PERCENT=50
APP_KEY=replace-with-a-random-secret-of-at-least-32-characters----

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=examcore
DB_USERNAME=examcore_user
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
DB_PREFIX=cbt_
# Integration tests create and wipe this database. It must end in _test.
DB_TEST_DATABASE=examcore_test

SESSION_NAME=examcore_session
SESSION_LIFETIME=7200
SESSION_SAME_SITE=Lax
SESSION_COOKIE_PATH=/
INTEGRATION_MODE=standalone

# Maintenance (auto-submit expired exams, send queued email).
# true  = run on normal web traffic; required on hosts without cron (e.g. InfinityFree).
# false = use cron instead:  * * * * *  php /path/to/cbt schedule:run
SCHEDULER_WEB_TRIGGER=true

# Email. Keep MAIL_ENABLED=false locally unless SMTP is configured; PHP mail() is blocked on many hosts.
MAIL_ENABLED=false
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yourdomain.ng
MAIL_FROM_NAME="ExamCore CBT"

# Public address of the site (no trailing slash). Used for links inside emails, such as password resets.
APP_URL=https://yourdomain.ng
